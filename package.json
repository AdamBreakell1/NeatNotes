{
  "name": "notes-app",
  "version": "1.0.0",
  "description": "A student-focused OCR A-Level Computer Science revision workspace with retrieval practice, personal notes and progress tracking.",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "check": "node scripts/check-syntax.js",
    "validate:content": "node scripts/validate-content.js",
    "test": "node --test backend/*.test.js backend/**/*.test.js",
    "test:browser": "node scripts/browser-smoke.cjs",
    "coverage:content": "node scripts/report-coverage.js",
    "review:content": "node scripts/review-content.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
