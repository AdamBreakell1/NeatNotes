PORT=4173
BASE_URL=http://localhost:4173
DATABASE_PATH=./data/neat-notes.sqlite
NODE_ENV=development
JSON_BODY_LIMIT=1mb

# Comma-separated origins allowed to call the API with credentials.
# For local development this should match BASE_URL.
CORS_ORIGIN=http://localhost:4173

# Auth endpoint limit per IP/path per 15 minutes.
AUTH_RATE_LIMIT=25

# Public contact form settings.
CONTACT_TO=neatnotescontact@gmail.com
CONTACT_RATE_LIMIT=8

# Optional: real email verification delivery.
# Without SMTP_HOST, verification links are printed to the server console during local dev.
# Contact form delivery also uses these SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Neat Notes <no-reply@example.com>"

# Optional: Google OAuth.
# Create credentials in Google Cloud Console and add this redirect URI:
# http://localhost:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: real subscription billing through Stripe Checkout.
# Create Products/Prices in Stripe, then paste the Price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEACHER=
STRIPE_PRICE_INSTITUTION=

# Local development only. Never enable this in production.
ALLOW_MOCK_BILLING=false
FREE_REVISION_TOPIC_LIMIT=3
